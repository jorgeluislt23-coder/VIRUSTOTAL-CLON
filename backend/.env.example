# Server Configuration
PORT=3000
NODE_ENV=development

# Database URLs
DATABASE_URL=postgresql://user:password@localhost:5432/virustotal
MONGODB_URI=mongodb://localhost:27017/virustotal
REDIS_URL=redis://localhost:6379

# API Keys - Security APIs
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
URLSCAN_API_KEY=your_urlscan_api_key_here
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
SHODAN_API_KEY=your_shodan_api_key_here
GOOGLE_SAFE_BROWSING_KEY=your_google_safe_browsing_key_here
ALIENVAULT_OTX_KEY=your_alienvault_otx_key_here
HYBRID_ANALYSIS_KEY=your_hybrid_analysis_key_here

# Storage Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=650000000

# Security Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# CORS Configuration
CORS_ORIGIN=http://localhost:3001

# Redis Cache TTL (seconds)
CACHE_TTL=3600
